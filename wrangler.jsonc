// Cloudflare settings for the live site. You normally never need to edit this.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sula-products",
  "compatibility_date": "2026-10-23",
  // Turns on the free address sula-products.thanialkiyumi.workers.dev
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    // The whole folder is the website (there is no build step)
    "directory": ".",
    // Unknown links show our "page not found" page
    "not_found_handling": "404-page"
  }
}
